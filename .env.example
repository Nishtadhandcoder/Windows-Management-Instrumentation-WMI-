# ==============================================================
# Windows Management Instrumentation (WMI) System Monitor Config
# ==============================================================

# Target Windows Machine Configuration
# Leave WMI_HOST empty or "localhost" for local machine.
# For remote machines, provide remote hostname/IP with administrative credentials.
WMI_HOST=localhost
WMI_USER=
WMI_PASSWORD=
WMI_NAMESPACE=root\cimv2

# MongoDB Database Configuration
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=wmi_system_monitor
MONGO_COLLECTION_NAME=system_snapshots
MONGO_TIMEOUT_MS=5000

# Data Collection & Scheduler Settings
COLLECTION_INTERVAL_SECONDS=60
SCHEDULER_ENABLED=true

# REST API & Web Dashboard Settings
API_HOST=127.0.0.1
API_PORT=8000

# Logging & Offline Storage
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/wmi_monitor.log
OFFLINE_CACHE_DIR=data/snapshots
